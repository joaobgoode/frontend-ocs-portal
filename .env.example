# Supabase — crie um projeto em https://supabase.com e copie em Project Settings → API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Backend da API (GET /api/user-permissions/me usa Bearer do Supabase)
VITE_API_BASE_URL=http://localhost:8080

# true | 1 | yes — registra no console a resposta de /api/user-permissions/me
VITE_DEBUG_PERMISSIONS=false

# Produções: GET /api/producoes (filtros na query). Criar/editar no front usa
# POST /api/producoes, PATCH /api/producoes/:id, DELETE /api/producoes/:id — confira no backend.

# Paradas: GET/POST /api/paradas, GET/PATCH/PUT/DELETE /api/paradas/:id
# Manutenção: GET /api/manutencao/equipe

# Estufas: GET/POST /api/estufas (query opcional: maquina), GET/PATCH/PUT/DELETE /api/estufas/:id

# Mapa (produção): agrega GET /api/producoes, /api/estufas e /api/paradas com data + maquina
# Abrir edição a partir do mapa usa GET /api/producoes/:id e GET /api/estufas/:id (e paradas/:id)
    